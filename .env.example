# =============================================================================
# Polymarket Reverse Bot — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Wallet & Auth ---
PRIVATE_KEY=                         # EOA private key (hex, no 0x prefix)
POLY_API_KEY=your-polymarket-api-key # L2 API key from Polymarket
POLY_API_SECRET=your-polymarket-api-secret # L2 API secret
POLY_PASSPHRASE=your-polymarket-passphrase # L2 passphrase
POLY_ADDRESS=                         # Optional proxy wallet address (Smart Contract proxy/Gnosis Safe)
POLY_SIGNATURE_TYPE=2                 # Signature type (0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE, 3=POLY_1271)


# --- Network ---
CHAIN_ID=137                          # Polygon mainnet
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# --- Strategy Parameters ---
YES_BIAS_THRESHOLD=0.80               # Trigger when Yes >= this
YES_BIAS_MAX_THRESHOLD=0.97           # Ignore if Yes >= this (already resolving)
MIN_VOLUME_24H_USDC=500               # Minimum taker-side 24h volume
MIN_TIME_TO_CLOSE_HOURS=6             # Skip markets closing in < 6h
MAX_TIME_TO_CLOSE_DAYS=90             # Skip markets too far out
POSITION_SIZE_USDC=2.0                # Per-trade risk in USDC
MAX_OPEN_POSITIONS=2                  # Never hold more than this
MAX_DAILY_LOSS_USDC=5.0               # Kill switch threshold
MAX_TOTAL_EXPOSURE_USDC=5.0           # Total across all open positions
TAKE_PROFIT_MULTIPLIER=3.0            # Close when No worth 3× entry
STOP_LOSS_MULTIPLIER=0.5              # Close when position loses 50%
POLL_INTERVAL_SECONDS=10              # Scan frequency; keep <= 30 for crypto_short_window mode
RATE_LIMIT_ORDERS_PER_MIN=55          # Stay under 60/min hard limit
RATE_LIMIT_API_CALLS_PER_MIN=90       # Stay under 100/min hard limit

# --- Mode ---
PAPER_TRADE=true                      # Required for crypto_short_window mode
MIN_STREAK_QUALITY_SCORE=0.45         # Passive audit threshold for market choppiness (Option A)
STREAK_QUALITY_WINDOW=7               # Lookback window for same-direction transitions (7 transitions from 8 outcomes)
LOSSMOMENTUM_SKIP_ENABLED=true        # Enable skip/fade mode
BOT_VERSION=v0.1.0                    # Current bot version

# --- Category Whitelist (comma-separated) ---
CATEGORY_WHITELIST=Sports,Politics,Crypto,Finance,Weather,Entertainment

# --- Market Targeting ---
TARGET_MARKET_MODE=crypto_short_window            # broad | crypto_short_window
TARGET_CRYPTO_SYMBOLS=BTC,ETH                     # Only these short-window crypto markets are tracked
TARGET_WINDOW_MINUTES=5,15                        # Only these window lengths are tracked
SHORT_WINDOW_DISCOVERY_INTERVAL_SECONDS=30        # Refresh rapidly enough for 5m/15m markets
SHORT_WINDOW_MIN_SECONDS_TO_CLOSE=60              # Skip entries too close to window expiry

# --- Database ---
DB_PATH=data/reversebot.db            # SQLite path (relative to project root)

# --- Logging ---
LOG_DIR=logs                          # Log directory
LOG_LEVEL=INFO                        # DEBUG/INFO/WARNING/ERROR/CRITICAL
